   "source": [
    "# Frozenset of squares of odd numbers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "4b2b5f84-1715-4b34-9951-511bac86782c",
   "metadata": {},
   "outputs": [],
   "source": [
    "def frozen_odd_squares(n):\n",
    "    return frozenset({x**2 for x in range(1,n,1)})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c7e84c53-c0fa-4204-bac1-f7a2438ffe67",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "frozenset({1, 4, 9, 16, 25, 36, 49, 64, 81})"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "n = 10\n",
    "frozen_odd_squares(n)"
   ]
  },
