   ],
   "source": [
    "def bytearray_from_list(l):\n",
    "    return bytearray(l)\n",
    "\n",
    "l = [72, 123, 21, 108, 222, 62, 44, 38,10]\n",
    "print(bytearray_from_list(l))"
