   "source": [
    "from collections import Counter\n",
    "\n",
    "l = ['abc','bac','lil','bro','cab']\n",
    "s = 'abc'\n",
    "\n",
    "print(list(filter(lambda x: Counter(s) == Counter(x),l)))"
   ]
  },
