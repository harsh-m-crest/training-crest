     "text": [
      "[['R', 'e', 'd'], ['G', 'r', 'e', 'e', 'n'], ['B', 'l', 'a', 'c', 'k'], ['O', 'r', 'a', 'n', 'g', 'e']]\n"
     ]
    }
   ],
   "source": [
    "def str_to_list(s):\n",
    "    return list(map(list,s))\n",
    "\n",
    "l = ['Red', 'Green','Black','Orange']\n",
    "print(str_to_list(l))"
   ]
