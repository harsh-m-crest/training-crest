   "source": [
    "# Filter Prime Numbers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "f22806c8-477d-4f8f-bba4-522cd84da4a3",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[2, 3, 5, 67, 11, 17, 19]"
      ]
     },
     "execution_count": 4,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "def is_prime(n):\n",
    "    if n == 1:\n",
    "        return False\n",
    "    for i in range(2,n//2 +1):\n",
    "        if n %i ==0:\n",
    "            return False\n",
    "    return True\n",
    "\n",
    "l = [1,2,3,4,5,67,8,9,10,11,1,213,14,15,16,17,18,19,20]\n",
    "\n",
    "list(filter(is_prime,l))"
   ]
  },
